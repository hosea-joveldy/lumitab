{
  "manifest_version": 2,
  "name": "Lumi New Tab",
  "version": "1.3",
  "browser_specific_settings": {
    "gecko": {
      "id": "newtab@lumi"
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "https://github.com/*"
  ],
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}
