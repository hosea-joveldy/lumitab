{
  "manifest_version": 2,
  "name": "lumitab",
  "version": "1.4",
  "browser_specific_settings": {
    "gecko": {
      "id": "newtab@lumi"
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["https://github.com/*"],
